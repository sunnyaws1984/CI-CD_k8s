pipeline {

    // Tools (kaniko, kubectl) come from the Jenkins agent pod template
    agent { label 'ci-agent' }

    environment {
        APP_NAME      = "fastapi-cicd-demo"
        DOCKER_USER   = "sunnyaws1984"
        IMAGE_NAME    = "${DOCKER_USER}/${APP_NAME}"
        K8S_NAMESPACE = "default"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )]) {
                        sh '''
                            AUTH=$(printf "%s:%s" "$DH_USER" "$DH_TOKEN" | base64 | tr -d '\\n')
                            mkdir -p /kaniko/.docker
                            printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$AUTH" > /kaniko/.docker/config.json

                            /kaniko/executor \
                              --context=$WORKSPACE/fastapi-cicd-project \
                              --dockerfile=$WORKSPACE/fastapi-cicd-project/Dockerfile \
                              --destination=${IMAGE_NAME}:${BUILD_NUMBER}
                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                container('kubectl') {
                    sh '''
                        kubectl set image deployment/html-demo \
                          web=${IMAGE_NAME}:${BUILD_NUMBER} \
                          -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/html-demo \
                          -n ${K8S_NAMESPACE} --timeout=120s
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                container('kubectl') {
                    sh '''
                        kubectl get pods -n ${K8S_NAMESPACE}
                        kubectl get services -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }
    }

    post {
        success { echo 'CI/CD pipeline completed successfully!' }
        failure { echo 'CI/CD pipeline failed. Check Jenkins console output.' }
        always  { echo 'Pipeline execution finished.' }
    }
}