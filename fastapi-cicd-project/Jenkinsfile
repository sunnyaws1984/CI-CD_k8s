
pipeline {
    agent any

    environment {
        APP_NAME = "fastapi-cicd-demo"
        DOCKER_USER = "sunnyaws1984"
        IMAGE_NAME = "${DOCKER_USER}/${APP_NAME}"
        K8S_NAMESPACE = "default"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Install Python') {
            steps {
                sh '''
                    echo "Installing Python on Jenkins Agent..."

                    apt-get update
                    apt-get install -y python3 python3-pip python3-venv

                    echo "Python version:"
                    python3 --version

                    echo "Pip version:"
                    python3 -m pip --version
                '''
            }
        }        

        stage('Install Dependencies') {
            steps {
                dir('fastapi-cicd-project') {
                    sh 'python3 -m pip install -r requirements.txt'
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('fastapi-cicd-project') {
                    sh 'python3 -c "from app import app; print(app.title)"'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('fastapi-cicd-project') {
                    sh '''
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                    '''
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login \
                        -u "$DH_USER" --password-stdin

                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig-credentials',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        kubectl set image deployment/fastapi-app \
                        fastapi-container=${IMAGE_NAME}:${BUILD_NUMBER} \
                        -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/fastapi-app \
                        -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'kubeconfig-credentials',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        kubectl get pods -n ${K8S_NAMESPACE}
                        kubectl get services -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'CI/CD pipeline failed. Check Jenkins console output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
